---
import StatusBadge from "./StatusBadge.astro";
import { CATEGORY_META, EVENT_META, type Person } from "../lib/schema";
import { formatDate, initials, lastEvent, personUrl } from "../lib/data";

interface Props {
  person: Person;
}

const { person } = Astro.props;
const last = lastEvent(person);
---

<a
  href={personUrl(person)}
  class="person-card group block rounded-xl border border-stone-200 bg-white p-4 shadow-sm transition hover:border-stone-300 hover:shadow-md"
  data-name={person.name.toLocaleLowerCase("tr")}
  data-status={person.currentStatus}
  data-category={person.category}
>
  <div class="flex items-start gap-3">
    <span
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-stone-800 text-sm font-semibold text-white"
    >
      {initials(person.name)}
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <h3 class="truncate font-semibold group-hover:underline">
          {person.name}
        </h3>
        <StatusBadge status={person.currentStatus} />
      </div>
      <p class="mt-0.5 text-xs font-medium text-stone-500">
        {CATEGORY_META[person.category].label}
      </p>
    </div>
  </div>
  <p class="mt-3 line-clamp-2 text-sm text-stone-600">{person.summary}</p>
  <p class="mt-3 text-xs text-stone-400">
    Son gelişme: {EVENT_META[last.type].label} · {formatDate(last.date)}
  </p>
</a>
