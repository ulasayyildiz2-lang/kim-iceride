---
import Layout from "../../layouts/Layout.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import {
  people,
  getCase,
  caseUrl,
  formatDate,
  initials,
  sortedEvents,
} from "../../lib/data";
import { CATEGORY_META, EVENT_META } from "../../lib/schema";

export function getStaticPaths() {
  return people.map((person) => ({
    params: { slug: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const personCase = getCase(person.case);
const events = sortedEvents(person).reverse(); // en yeni en üstte
---

<Layout title={person.name} description={person.summary}>
  <nav class="text-sm text-stone-500">
    <a href="/" class="hover:underline">Kişiler</a>
    <span class="mx-1">/</span>
    <span class="text-stone-700">{person.name}</span>
  </nav>

  <header class="mt-4 flex flex-wrap items-start gap-4">
    <span
      class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-stone-800 text-xl font-semibold text-white"
    >
      {initials(person.name)}
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight">{person.name}</h1>
        <StatusBadge status={person.currentStatus} size="md" />
      </div>
      <p class="mt-1 text-sm font-medium text-stone-500">
        {CATEGORY_META[person.category].label}
        {
          personCase && (
            <>
              {" · "}
              <a href={caseUrl(personCase)} class="text-stone-700 underline hover:text-stone-900">
                {personCase.name}
              </a>
            </>
          )
        }
      </p>
      <p class="mt-3 max-w-2xl text-stone-700">{person.summary}</p>
    </div>
  </header>

  <section class="mt-10 max-w-2xl">
    <h2 class="text-lg font-semibold">Süreç</h2>
    <ol class="mt-4 space-y-0">
      {
        events.map((event, i) => (
          <li class="relative pb-8 pl-8 last:pb-0">
            {i < events.length - 1 && (
              <span class="absolute left-[7px] top-5 h-full w-px bg-stone-200" />
            )}
            <span
              class={`absolute left-0 top-1.5 h-[15px] w-[15px] rounded-full border-2 border-white ring-1 ring-stone-200 ${EVENT_META[event.type].dot}`}
            />
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="font-semibold">{EVENT_META[event.type].label}</span>
              <time class="text-sm text-stone-400" datetime={event.date}>
                {formatDate(event.date)}
              </time>
              {i === 0 && (
                <span class="rounded-full bg-stone-900 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white">
                  Son gelişme
                </span>
              )}
            </div>
            <p class="mt-1 text-stone-700">{event.description}</p>
            <p class="mt-1.5 text-xs text-stone-400">
              Kaynak:{" "}
              {event.sources.map((s, j) => (
                <>
                  {j > 0 && " · "}
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-stone-600"
                  >
                    {s.outlet}
                  </a>
                </>
              ))}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <p class="mt-10 text-xs text-stone-400">
    Son güncelleme: {formatDate(person.lastUpdated)}
  </p>
</Layout>
