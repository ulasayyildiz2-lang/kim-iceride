---
import Layout from "../../layouts/Layout.astro";
import { cases, peopleInCase, caseUrl } from "../../lib/data";
---

<Layout title="Davalar ve soruşturmalar">
  <h1 class="text-2xl font-bold tracking-tight">Davalar ve soruşturmalar</h1>
  <p class="mt-1 max-w-3xl text-stone-600">
    Takip edilen kişilerin dahil olduğu dava ve soruşturma grupları.
  </p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      cases.map((c) => {
        const members = peopleInCase(c.id);
        return (
          <a
            href={caseUrl(c)}
            class="group block rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition hover:border-stone-300 hover:shadow-md"
          >
            <h2 class="font-semibold group-hover:underline">{c.name}</h2>
            <p class="mt-1 line-clamp-2 text-sm text-stone-600">
              {c.description}
            </p>
            <p class="mt-3 text-xs text-stone-400">{members.length} kişi</p>
          </a>
        );
      })
    }
  </div>
</Layout>
